# CORS_ORIGIN is deliberately not picked up here: alchemy.run.ts derives it
# from the stage's own web hostname rather than reading it from the env.
# @import(../../apps/server/, pick=[NODE_ENV, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_SECRET_ID, OAUTH_PROXY_SECRET])
# @defaultRequired=false
# @defaultSensitive=true
# ---
ALCHEMY_PASSWORD=

# Enable Axiom provisioning and remote log draining during alchemy dev.
# Deployments always enable Axiom and require its credentials.
# @public @type=boolean
AXIOM_DEV_ENABLED=false
