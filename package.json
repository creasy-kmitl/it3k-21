{
  "name": "it3k",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^7.0.2",
      "@types/node": "^26.6.6",
      "varlock": "1.24.0",
      "@cloudflare/workers-types": "^5.20261112.1",
      "better-auth": "1.7.22",
      "evlog": "^2.35.1",
      "lucide-react": "^1.72.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
      "vite-plus": "1.6.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "lint:biome": "biome lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "db:generate": "vp run --filter @it3k/db db:generate",
    "db:local": "bun run --cwd packages/db db:local",
    "db:local:studio": "bun run --cwd packages/db db:local:studio",
    "deploy": "vp run --filter @it3k/infra deploy",
    "destroy": "vp run --filter @it3k/infra destroy",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "it3k": ".",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cloudflare/workers-types": "catalog:",
    "@it3k/config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "catalog:",
    "rolldown": "1.3.2",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
