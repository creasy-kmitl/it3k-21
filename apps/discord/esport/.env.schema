# @defaultRequired=true
# @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# Bot token from https://discord.com/developers/applications → Bot.
# @sensitive @type=string(minLength=1)
DISCORD_BOT_TOKEN=

# The one guild (server) the bot serves. Slash commands register here only,
# which makes them show up at once instead of after global propagation.
# @type=string(minLength=1)
DISCORD_GUILD_ID=

# The API the bot uses until someone runs /mode; /mode's choice is kept in
# SQLITE_PATH and wins over this from then on.
# @type=enum(dev, stg, prod)
DEFAULT_MODE=dev

# Where each mode's API lives (apps/server). `dev` is `bun run dev` on this machine.
# @type=url
API_URL_DEV=http://localhost:3000

# @type=url
API_URL_STG=https://it3k-api-staging.creasy.club

# @type=url
API_URL_PROD=https://it3k-api.creasy.club

# A bot token per stage, issued by an admin on that stage's web dashboard
# (/staff/bot-tokens; it is shown once). A mode without one cannot be
# switched to.
# @sensitive @required=false @type=string
BOT_API_TOKEN_DEV=

# @sensitive @required=false @type=string
BOT_API_TOKEN_STG=

# @sensitive @required=false @type=string
BOT_API_TOKEN_PROD=

# The bot keeps no data of its own beyond the current mode, stored here.
# The Docker image points it at its /data volume.
# @type=string(minLength=1)
SQLITE_PATH=./data/bot.sqlite
