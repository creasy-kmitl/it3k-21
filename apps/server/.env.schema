# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @public @dynamic @type=url
CORS_ORIGIN=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_DATASET=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=url
AXIOM_EDGE_URL=

# Deploy stage (prod, staging, pr-42). Tags every log event so the stages that
# share a tier's Axiom dataset stay separable.
# @public @dynamic @required=false @type=string(minLength=1)
DEPLOY_ENV=

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# @public @type=string
GOOGLE_CLIENT_ID=

# @type=string
GOOGLE_SECRET_ID=

# The server whose Google redirect URI this stage signs in through. Equal to
# BETTER_AUTH_URL on every stage with a stable hostname (prod, staging,
# localhost), which makes Better Auth's oAuthProxy a no-op there. Only `pr-*`
# previews point it elsewhere: their hostnames cannot be registered with
# Google, which matches redirect URIs byte for byte.
# @public @dynamic @type=url
AUTH_PROXY_URL=

# Encrypts the profile the relay hands back to a preview, so it must hold the
# same value on both. Kept separate from BETTER_AUTH_SECRET on purpose: a key
# shared across stages must not also be the one that signs session cookies.
# @type=string(minLength=32)
OAUTH_PROXY_SECRET=

# Comma-separated origin patterns the relay stage may redirect back to, e.g.
# `https://it3k-pr-*.creasy.club`. Empty on every stage that is not the relay.
# @public @dynamic @required=false @type=string
AUTH_PREVIEW_ORIGINS=
