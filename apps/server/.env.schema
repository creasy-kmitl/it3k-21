# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @public @dynamic @type=url
CORS_ORIGIN=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_DATASET=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=url
AXIOM_EDGE_URL=

# Deploy stage (prod, staging, pr-42). Tags every log event so the stages that
# share a tier's Axiom dataset stay separable.
# @public @dynamic @required=false @type=string(minLength=1)
DEPLOY_ENV=

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# @public @type=string
GOOGLE_CLIENT_ID=

# @type=string
GOOGLE_SECRET_ID=

# The server whose Google redirect URI this stage signs in through. Equal to
# BETTER_AUTH_URL on every stage with a stable hostname (prod, staging,
# localhost), which makes Better Auth's oAuthProxy a no-op there. Only `pr-*`
# previews point it elsewhere: their hostnames cannot be registered with
# Google, which matches redirect URIs byte for byte.
# @public @dynamic @type=url
AUTH_PROXY_URL=

# Encrypts the profile the relay hands back to a preview, so it must hold the
# same value on both. Kept separate from BETTER_AUTH_SECRET on purpose: a key
# shared across stages must not also be the one that signs session cookies.
# Optional for alchemy dev; omit it to disable the proxy and sign in directly
# through localhost. Alchemy requires it for deployments.
# @type=string @required=false
OAUTH_PROXY_SECRET=

# Comma-separated origin patterns the relay stage may redirect back to, e.g.
# `https://it3k-pr-*.creasy.club`. Empty on every stage that is not the relay.
# @public @dynamic @required=false @type=string
AUTH_PREVIEW_ORIGINS=

# Discord OAuth app from https://discord.com/developers/applications, used only
# to link Discord accounts for esports (never to sign in). It must be the esports
# bot's own application (apps/discord/esport), because Discord lets only that
# app's bot add the user to the guild. Register
# `<BETTER_AUTH_URL>/api/auth/callback/discord` for each stable stage. Leave
# both empty to turn Discord linking off.
# @public @required=false @type=string
DISCORD_CLIENT_ID=

# @required=false @type=string
DISCORD_CLIENT_SECRET=

# The esports bot's token (same application as DISCORD_CLIENT_ID) and its guild.
# With both set, linking Discord adds staff and esports entrants to the guild
# (the guilds.join scope). Leave either empty to turn that off.
# @required=false @sensitive @type=string
DISCORD_BOT_TOKEN=

# @public @required=false @type=string
DISCORD_GUILD_ID=

