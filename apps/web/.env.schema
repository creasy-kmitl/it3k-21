# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_DATASET=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=url
AXIOM_EDGE_URL=

# Deploy stage (prod, staging, pr-42). Tags every log event so the stages that
# share a tier's Axiom dataset stay separable. Inlined into the bundle by Vite,
# so it has to be public.
# @public @required=false @type=string(minLength=1)
VITE_DEPLOY_ENV=
